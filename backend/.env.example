# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=your-account-id

# S3 Configuration (bucket names include account ID for uniqueness)
S3_RAW_DATA_BUCKET=retailmind-raw-data-060002399377
S3_ML_ARTIFACTS_BUCKET=retailmind-ml-artifacts-060002399377

# DynamoDB Configuration
DYNAMODB_TRANSACTIONS_TABLE=retailmind-transactions
DYNAMODB_AGENT_STATES_TABLE=retailmind-agent-states
DYNAMODB_WORKFLOW_INSTANCES_TABLE=retailmind-workflow-instances

# Redshift Configuration
REDSHIFT_HOST=retailmind-analytics.xxxxxx.us-east-1.redshift.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_CLUSTER_IDENTIFIER=retailmind-analytics
REDSHIFT_DATABASE=retailmind_warehouse
REDSHIFT_USER=admin
REDSHIFT_PASSWORD=your-redshift-password

# EventBridge Configuration
EVENTBRIDGE_BUS_NAME=retailmind-event-bus

# API Configuration
API_GATEWAY_STAGE=dev
COGNITO_USER_POOL_ID=your-user-pool-id

# CloudWatch Configuration
CLOUDWATCH_LOG_GROUP=/aws/retailmind
